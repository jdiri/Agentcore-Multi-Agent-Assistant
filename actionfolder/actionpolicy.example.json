{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCoordinatorToInvokeAction",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::<ACCOUNT_ID>:role/<RUNTIME_1_EXECUTION_ROLE_NAME>" },
      "Action": "bedrock-agentcore:InvokeAgentRuntime",
      "Resource": "arn:aws:bedrock-agentcore:us-east-1:<ACCOUNT_ID>:runtime/<RUNTIME_2_ID>"
    }
  ]
}
